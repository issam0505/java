<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.text.Text?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.projetpharmacie.CategoryController"
      spacing="20"
      stylesheets="@css/category.css">

    <!-- TOP BAR -->
    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="top-bar">
        <padding>
            <Insets top="10" right="20" bottom="10" left="20"/>
        </padding>

        <HBox spacing="10">
            <ImageView fitWidth="40" preserveRatio="true">
                <image>
                    <Image url="@../../../images/logof2.png"/>
                </image>
            </ImageView>
            <Text text="SwiftCare" styleClass="app-title"/>
        </HBox>

        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- SCROLLABLE CONTENT -->
    <ScrollPane fitToWidth="true"
                vbarPolicy="AS_NEEDED"
                hbarPolicy="NEVER"
                styleClass="scroll-pane">

        <VBox spacing="30" alignment="TOP_CENTER">
            <padding>
                <Insets top="20" right="20" bottom="30" left="20"/>
            </padding>

            <!-- CATEGORIES / PRODUITS -->
            <VBox fx:id="categoriesContainer" spacing="30"/>

            <!-- BACK BUTTON -->
            <Button text="⬅ Retour au Store"
                    styleClass="btn-back"
                    onAction="#goBackToStore"/>
        </VBox>
    </ScrollPane>

</VBox>
